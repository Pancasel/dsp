# Decagon CSVs (absolute paths, relative to the project root, or .zip archives)
TARGETS_FILE=../bio-decagon-targets/bio-decagon-targets.csv
PPI_FILE=../bio-decagon-ppi/bio-decagon-ppi.csv
COMBO_FILE=../bio-decagon-combo/bio-decagon-combo.csv
MONO_FILE=../bio-decagon-mono/bio-decagon-mono.csv
CACHE_DB=.cache/decagon.sqlite3

# Name / translation resources generated by scripts/ (committed in resources/)
DRUG_NAMES_FILE=resources/drug_names.csv
BRAND_ALIASES_FILE=resources/brand_aliases_vi.csv
GENE_NAMES_FILE=resources/gene_names.csv
SIDE_EFFECTS_VI_FILE=resources/side_effects_vi.csv
SERIOUS_KEYWORDS_FILE=resources/serious_keywords.csv

# Retrieval
HUB_DEGREE_THRESHOLD=500
TIER3_ONE_HOP_PER_PAIR=8
TIER3_TWO_HOP_PER_PAIR=4
TIER3_CANDIDATES_PER_PAIR=20
MAX_EVIDENCE=400
MAX_SERIOUS_EFFECTS=10
MAX_OTHER_EFFECTS=5

# Ranking weights (app/ranking.py)
RANK_W_RECURRENCE=1.0
RANK_W_IDF=0.5
RANK_W_NOT_IN_MONO=1.0
RANK_W_SERIOUS=2.0
RANK_W_AMPLIFIED=1.0

# OpenRouter (OpenAI-compatible). Leave the key empty to use the template fallback.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
LLM_TIMEOUT=120
