# Decagon CSV files (absolute paths, paths relative to the project root, or .zip archives)
DRUG_TARGETS_FILE=../bio-decagon-targets/bio-decagon-targets.csv
PROTEIN_INTERACTIONS_FILE=../bio-decagon-ppi/bio-decagon-ppi.csv
DRUG_PAIR_SIDE_EFFECTS_FILE=../bio-decagon-combo/bio-decagon-combo.csv
SINGLE_DRUG_SIDE_EFFECTS_FILE=../bio-decagon-mono/bio-decagon-mono.csv
# SQLite copy of the side-effect files, built on the first run (about 2 minutes)
CACHE_DATABASE_FILE=.cache/decagon.sqlite3

# Name / translation files built by resource_builders/ (committed in resources/)
DRUG_NAMES_FILE=resources/drug_names.csv
BRAND_ALIASES_FILE=resources/brand_aliases_vietnamese.csv
GENE_NAMES_FILE=resources/gene_names.csv
SIDE_EFFECT_TRANSLATIONS_FILE=resources/side_effect_translations_vietnamese.csv
SERIOUS_KEYWORDS_FILE=resources/serious_keywords.csv
SERIOUS_EFFECTS_FILE=resources/serious_effects.csv

# Retrieval
# Protein có nhiều hơn số liên kết này là "hub", không dùng làm bước trung gian
HUB_DEGREE_THRESHOLD=500
# 0 = dùng HUB_DEGREE_THRESHOLD; >0 = ngưỡng hub theo phân vị số liên kết protein (0-100)
HUB_DEGREE_PERCENTILE=0
# 1 = protein cách đích của >=3 thuốc một bước tương tác cũng tính là Tier 2
COUNT_CONVERGENCE_PROTEINS_AS_AMPLIFICATION=0
TIER3_ONE_HOP_BRIDGES_PER_PAIR=8
TIER3_TWO_HOP_BRIDGES_PER_PAIR=4
TIER3_CANDIDATE_EFFECTS_PER_PAIR=20
MAX_EVIDENCE_ITEMS=400
MAX_SERIOUS_EFFECTS=10
MAX_OTHER_EFFECTS=5

# Ranking weights (graphrag/side_effect_ranking/regimen_side_effect_scoring.py)
RANKING_WEIGHT_RECURRENCE=1.0
RANKING_WEIGHT_EFFECT_RARITY=0.5
RANKING_WEIGHT_ABSENT_FROM_SINGLE_DRUG_DATA=1.0
RANKING_WEIGHT_SERIOUS=2.0
RANKING_WEIGHT_AMPLIFIED=1.0
RANKING_WEIGHT_CRITICAL=2.0

# OpenRouter (OpenAI-compatible). Leave the key empty to use the template fallback.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
LLM_TIMEOUT_SECONDS=120
